# Copy to .env and fill in. Never commit .env.

# Which part of the server to start: api | worker | receiver | scheduler | migrate
MODE=api
PORT=3000
LOG_LEVEL=info

# Local default matches infra/compose.dev.yml
DATABASE_URL=postgres://reaplift:reaplift@localhost:5432/reaplift

# Set by the deploy pipeline; leave blank locally ("dev" is used)
APP_VERSION=

# Milestone 1 onward (leave blank for now)
APP_ENCRYPTION_KEY=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=

# Milestone 4: uploaded lists (blank = default). Until Object Storage exists, files
# are kept under UPLOAD_DIR (default var/uploads, relative to apps/server).
# UPLOAD_SIGNING_SECRET must be set on any shared server.
UPLOAD_DIR=
UPLOAD_SIGNING_SECRET=
UPLOAD_MAX_BYTES=
LIST_MAX_ROWS=

# Later (Oracle Cloud backups)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
