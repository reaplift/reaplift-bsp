# Copy to .env and fill in. Never commit .env.

# Which part of the server to start: api | worker | receiver | scheduler | migrate
MODE=api
PORT=3000
LOG_LEVEL=info

# Local default matches infra/compose.dev.yml
DATABASE_URL=postgres://reaplift:reaplift@localhost:5432/reaplift

# Set by the deploy pipeline; leave blank locally ("dev" is used)
APP_VERSION=

# Milestone 1 onward (leave blank for now)
APP_ENCRYPTION_KEY=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=

# M1 login. PANEL_ORIGIN blank means http://localhost:5173. SESSION_COOKIE_SECURE blank means true;
# set it to false for local development over plain http.
PANEL_ORIGIN=
SESSION_COOKIE_SECURE=

# M2 email. EMAIL_PROVIDER blank means fake (emails go to the log). smtp needs the SMTP_ settings
# (OCI Email Delivery); EMAIL_FROM blank means info@reaplift.com. EMAIL_FAKE_FAIL makes the fake fail.
EMAIL_PROVIDER=
EMAIL_FAKE_FAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Panel (apps/web). VITE_API_MODE=mock answers API calls from fake in-browser data (development only;
# production builds always call the server). Blank means real.
VITE_API_MODE=

# Later (Oracle Cloud backups)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
